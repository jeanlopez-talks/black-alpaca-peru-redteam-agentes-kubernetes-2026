# Imagen única de los agentes del duelo (azul, rojo y aprobación). Cada pod elige su
# entrypoint: `blue-reviewer`, `red-attacker` o `approval-agent`.
#
# - Bases fijadas por digest (linux/amd64): un tag movido no cambia la imagen.
# - Dependencias exactas del uv.lock (`--frozen`), sin las de desarrollo.
# - La imagen final no lleva uv ni herramientas de build; corre como uid 1001 y funciona
#   con raíz de solo lectura (sin bytecode en runtime).

FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv

FROM registry.access.redhat.com/ubi9/python-311:9.8@sha256:a0bdb55576fc5b8d6704279307817828ef027e1065533ceba133fe9516003a6c AS build
USER 0
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/bin/python3.11 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build
# Primero solo las dependencias: esta capa se reutiliza mientras no cambie el lock.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM registry.access.redhat.com/ubi9/python-311:9.8@sha256:a0bdb55576fc5b8d6704279307817828ef027e1065533ceba133fe9516003a6c
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
LABEL org.opencontainers.image.title="devsecops-agents" \
      org.opencontainers.image.description="Agentes del duelo rojo vs azul (A2A)" \
      org.opencontainers.image.source="https://github.com/jeanlopez-talks/black-alpaca-peru-redteam-agentes-kubernetes-2026"
USER 1001
CMD ["blue-reviewer"]
